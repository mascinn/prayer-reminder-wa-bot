# Target WhatsApp Chat/Group JID
# Format for Group: 120363xxxxxx@g.us (Type '!jid' in your group to get this)
# Format for Direct Chat (testing): 628xxxxxxxxxx@s.whatsapp.net
TARGET_JID=120363000000000000@g.us

# Optional Turso SQLite Cloud Database (Recommended for 24/7 cloud deployment)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# Local SQLite Database fallback (used when TURSO_DATABASE_URL is empty)
DB_PATH=./data/bot.db

# Enable Thursday Night 21:00 WIB Friday reminder
ENABLE_JUMAT_REMINDER=false

# Timezone (WIB)
TIMEZONE=Asia/Jakarta

# Kemenag MyQuran City ID (1014 = Kota Bandar Lampung / Rajabasa / UNILA)
CITY_ID=1014

# Logging verbosity (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Optional admin WhatsApp JIDs separated by commas for restricted operations
ADMIN_JIDS=6285700000001@s.whatsapp.net
